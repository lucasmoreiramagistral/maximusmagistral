# Copie para .env.local e preencha. NUNCA commite valores reais de segredo.
#
# ── Publicas ────────────────────────────────────────────────────────────────
# Estas duas vao para dentro do bundle JavaScript e chegam ao navegador de
# todo mundo. Nao sao segredo: quem protege os dados e o RLS, nao a chave.
# Por isso ficam no .env versionado — o build da Lovable precisa delas.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

VITE_SUPABASE_PROJECT_ID=seu-project-id
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
VITE_IT_STORAGE_BASE_URL=https://SEU-PROJETO.supabase.co/storage/v1/object/public/BUCKET
VITE_TUTORIAIS_STORAGE_BASE_URL=

# ── Privada ─────────────────────────────────────────────────────────────────
# SO no .env.local (que o .gitignore bloqueia) e nas variaveis de ambiente da
# hospedagem. Ignora todo o RLS. Nunca use no navegador, nunca cole em chat,
# nunca mande para revisor.
#
# Ao rotacionar esta chave, atualize TAMBEM o painel da hospedagem — senao a
# criacao de usuarios para de funcionar em producao.
SUPABASE_SERVICE_ROLE_KEY=
